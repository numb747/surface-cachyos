# ============================================================================
#  Surface Type Cover 插拔 → 自动切换平板/PC 模式
#
#  装法（要 sudo，自己跑）：
#      sudo install -m644 udev/70-surface-tablet-mode.rules \
#           /etc/udev/rules.d/70-surface-tablet-mode.rules
#      sudo udevadm control --reload-rules
#      sudo udevadm trigger --action=add --attr-match=idVendor=045e --attr-match=idProduct=09c0
#
#  验证：
#      systemctl --user status dev-typecover.device surface-typecover.service
#
#  ■ 本规则【不跑任何命令】，只把 Cover 交给 systemd
#      早先这里是 RUN+="systemd-run --user ... tablet-mode auto"。
#      那条【从来没成功过】（2026-09-27 查日志，3 天 15 次全部 exit 1）：
#      RUN 以 root 跑，`systemd-run --user` 连的是 root 自己的用户管理器，
#      而 root 没有登录会话、没有那个管理器。就算连上了，$HOME 也是 /root，
#      标记文件会写错地方。doctor 只查规则文件在不在，所以一直报绿。
#
#      现在的链路：
#        udev 打 systemd 标签 + 别名 /dev/typecover
#          → 每个用户管理器里出现 dev-typecover.device
#          → SYSTEMD_USER_WANTS 拉起用户单元 surface-typecover.service
#            （systemd/surface-typecover.service，跑在【用户自己】的会话里）
#        拔掉 → 设备单元消失 → 该单元 BindsTo 它，被停掉 → ExecStop 再判一次
#
#  ■ ACTION!="remove" 而不是 ACTION=="add"
#      USB 设备 add 之后紧跟一个 bind 事件。systemd 以【最近一次事件】的标签
#      为准：bind 事件没带 systemd 标签，设备单元就会被当成拔掉了。
#
#  ■ 为什么匹配 idVendor/idProduct 而不是端口号
#      早先写的是 KERNEL=="1-7"（USB 端口号），换机型、换 Cover、换 USB 拓扑
#      都会变。按设备 ID 匹配：045e = Microsoft，09c0 = Surface Type Cover。
#      tablet/tablet-mode 里用的是同一对值。
#
#  ■ 开机那一次不归这里管
#      开机时 Cover 若本来就没接，没有任何设备事件。改由 Hyprland 启动时跑
#      一次 tablet-mode auto（config/hypr/config/autostart.lua）。
# ============================================================================

ACTION!="remove", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", \
    ATTR{idVendor}=="045e", ATTR{idProduct}=="09c0", \
    TAG+="systemd", \
    ENV{SYSTEMD_ALIAS}+="/dev/typecover", \
    ENV{SYSTEMD_USER_WANTS}+="surface-typecover.service"
