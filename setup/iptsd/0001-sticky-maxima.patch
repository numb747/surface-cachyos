diff --git a/src/apps/perf/replay.cpp b/src/apps/perf/replay.cpp
new file mode 100644
index 0000000..752b9f0
--- /dev/null
+++ b/src/apps/perf/replay.cpp
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// iptsd-replay：把 iptsd-dump 录下的原始数据喂给 iptsd 自己的触点识别流程，
+// 按守护进程（apps/daemon/touch.hpp）的规则输出落指 / 抬起：
+//     <帧号> DOWN <index> <x> <y>   /   <帧号> UP <index>
+// 不创建输入设备、不碰系统，纯离线，用来在同一份录像上比较参数和补丁。
+//
+// 用法：IPTSD_CONFIG_FILE=xxx.conf iptsd-replay <dump.bin>
+
+#include <common/types.hpp>
+#include <contacts/contact.hpp>
+#include <core/generic/application.hpp>
+#include <core/linux/device/file.hpp>
+#include <core/linux/runner.hpp>
+
+#include <CLI/CLI.hpp>
+#include <fmt/core.h>
+
+#include <set>
+#include <vector>
+
+namespace iptsd::apps::replay {
+
+class Replay : public core::Application {
+public:
+	usize frame = 0;
+	std::set<usize> down {};
+
+	Replay(const core::Config &config, const core::DeviceInfo &info)
+		: core::Application(config, info) {};
+
+	void on_touch(const std::vector<contacts::Contact<f64>> &contacts) override
+	{
+		frame++;
+		std::set<usize> now {};
+
+		for (const auto &c : contacts) {
+			if (!c.index.has_value())
+				continue;
+
+			const usize i = c.index.value();
+
+			// 与守护进程一致：不稳定的帧跳过（不更新、也不抬起）
+			if (!c.stable.value_or(true)) {
+				if (down.count(i))
+					now.insert(i);
+				continue;
+			}
+
+			bool lift = !c.valid.value_or(true);
+			lift |= c.mean.x() < 0 || c.mean.x() > 1;
+			lift |= c.mean.y() < 0 || c.mean.y() > 1;
+			if (lift)
+				continue;
+
+			now.insert(i);
+			if (!down.count(i))
+				fmt::print("{} DOWN {} {:.4f} {:.4f}\n", frame, i, c.mean.x(), c.mean.y());
+		}
+
+		for (const usize i : down)
+			if (!now.count(i))
+				fmt::print("{} UP {}\n", frame, i);
+
+		down = now;
+	}
+};
+
+} // namespace iptsd::apps::replay
+
+int main(int argc, char **argv)
+{
+	using namespace iptsd;
+	CLI::App app {"replay"};
+	std::filesystem::path path {};
+	app.add_option("DATA", path)->required();
+	CLI11_PARSE(app, argc, argv);
+
+	core::linux::Runner<apps::replay::Replay, core::linux::device::File> r {path};
+	r.run();
+	return 0;
+}
